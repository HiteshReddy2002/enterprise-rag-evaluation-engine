# Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# LLM & Embedding Settings
LLM_PROVIDER=openai # Options: openai, gemini, huggingface, mock
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_TOKENS=1024

# Vector DB Settings
VECTOR_STORE_TYPE=faiss # Options: faiss, memory
VECTOR_STORE_PATH=./data/vector_index

# Ingestion / Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=4

# Evaluation Thresholds (RAG Triad)
FAITHFULNESS_THRESHOLD=0.85
ANSWER_RELEVANCY_THRESHOLD=0.80
CONTEXT_PRECISION_THRESHOLD=0.75
